# OpenStreetMap Localization Environment Variables

# Development Mode
# Set to 'true' to bypass authentication and use mock user data
# This is useful for testing the UI without needing to authenticate with OpenStreetMap
#
# When enabled, development mode:
# - Skips OAuth authentication (uses mock user)
# - Simulates all write operations (no data sent to OSM)
# - Uses standard OSM tiles (https://tile.openstreetmap.org)
#
# WARNING: In dev mode, no actual updates will be sent to OSM
REACT_APP_DEV_MODE=false

# To enable development mode:
# 1. Copy this file to .env
# 2. Set REACT_APP_DEV_MODE=true
# 3. Restart the development server
